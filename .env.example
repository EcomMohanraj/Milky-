# Supabase configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay configuration
# Obtain these from your Razorpay Dashboard -> Settings -> API Keys (in Test mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mock settings for local sandbox evaluation
# Set to 'true' to allow simulated checkouts and mock order creations without contacting Razorpay
MOCK_PAYMENT=true
